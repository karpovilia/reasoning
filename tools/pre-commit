#!/usr/bin/env bash
# Крючок перед коммитом чистового репозитория чистовой репозиторий.
#
# Ставится командой make init, которая копирует этот файл в
# .git/hooks/pre-commit. Сам каталог крючков в git
# не попадает, поэтому крючок ставит каждый, кто клонирует репозиторий.
#
# Крючок проверяет три вещи и останавливает коммит на первой же неудаче:
#   1. оглавление документов совпадает с содержимым каталога docs;
#   2. опись корпусов цела;
#   3. в подготовленном к коммиту нет текстов закрытых бенчмарков и ключей доступа.
#
# Обойти крючок можно ключом --no-verify, но тогда ответственность за утечку
# ложится на того, кто его поставил.
set -u

ROOT="$(git rev-parse --show-toplevel)"
PY="${PY:-python3}"
status=0

run() {
    local title="$1"; shift
    echo "крючок: $title"
    if ! "$@"; then
        echo "крючок: проверка не пройдена: $title" >&2
        status=1
    fi
}

run "оглавление документов" \
    "$PY" "$ROOT/tools/build_docs_index.py" --check
run "опись корпусов" \
    "$PY" "$ROOT/tools/check_registry.py"
run "закрытые бенчмарки и ключи доступа" \
    "$PY" "$ROOT/tools/check_no_leaks.py" --staged

if [ "$status" -ne 0 ]; then
    echo "" >&2
    echo "коммит остановлен. Починить и повторить; пересобрать оглавление:" >&2
    echo "  python3 $ROOT/tools/build_docs_index.py" >&2
    exit 1
fi

echo "крючок: проверки пройдены"
exit 0
