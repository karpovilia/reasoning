#!/usr/bin/env bash
# Verify the implementation and the staged publication before committing.
set -eu
RELEASE_ROOT="$(git rev-parse --show-toplevel)"
RELEASE_PY="${PY:-python3}"
"$RELEASE_PY" "$RELEASE_ROOT/tools/release/check_release.py"
"$RELEASE_PY" "$RELEASE_ROOT/tools/check_no_leaks.py" --staged
