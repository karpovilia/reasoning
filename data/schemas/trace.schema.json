{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "trace.schema.json",
  "title": "trace",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "trace_id": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "corpus": {
      "type": "string",
      "minLength": 1
    },
    "benchmark": {
      "type": "string",
      "minLength": 1
    },
    "question_id": {
      "type": "string",
      "minLength": 1
    },
    "solver_run_id": {
      "type": "string",
      "minLength": 1
    },
    "seed": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "question": {
      "type": [
        "string",
        "null"
      ]
    },
    "reference_answer": {
      "type": [
        "string",
        "null"
      ]
    },
    "reasoning": {
      "type": "string"
    },
    "reasoning_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "final_answer": {
      "type": "string"
    },
    "correct": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "censored": {
      "type": "boolean"
    },
    "source": {
      "type": "object",
      "properties": {
        "file": {
          "type": "string",
          "minLength": 1
        },
        "file_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "record_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "line": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "file",
        "file_sha256",
        "record_sha256",
        "line"
      ],
      "additionalProperties": true
    },
    "segments": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "seg_id": {
            "type": "integer",
            "minimum": 0
          },
          "text": {
            "type": "string",
            "minLength": 1
          },
          "char_start": {
            "type": "integer",
            "minimum": 0
          },
          "char_end": {
            "type": "integer",
            "minimum": 0
          },
          "token_start": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0
          },
          "token_end": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0
          }
        },
        "required": [
          "seg_id",
          "text",
          "char_start",
          "char_end"
        ],
        "additionalProperties": true
      }
    }
  },
  "required": [
    "schema_version",
    "trace_id",
    "corpus",
    "benchmark",
    "question_id",
    "solver_run_id",
    "seed",
    "reasoning",
    "reasoning_sha256",
    "final_answer",
    "correct",
    "censored",
    "source",
    "segments"
  ],
  "additionalProperties": true
}
